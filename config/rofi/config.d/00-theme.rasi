/* ================================================================================================================== */
/* Rofi - Base Theme                                                                                                  */
/*                                                                                                                    */
/* Shared look for every panel: Catppuccin Macchiato, rounded pills, no scrollbar.                                    */
/* Panels in panels/ import this and only change layout.                                                              */
/* ================================================================================================================== */
/* Palette                                                                                                            */

@import "../themes/catppuccin-macchiato.rasi"

* {
    font:             "FiraCode Nerd Font 11";
    accent:           @mauve;
    background-color: transparent;
    text-color:       @text;
}

/* ================================================================================================================== */
/* Window                                                                                                             */

window {
    width:            720px;
    border:           2px solid;
    border-color:     @surface1;
    border-radius:    12px;
    background-color: @base;
}

mainbox {
    padding:  20px;
    spacing:  12px;
    children: [ inputbar, message, listview ];
}

/* ================================================================================================================== */
/* Search Bar                                                                                                         */

inputbar {
    padding:          10px 14px;
    spacing:          12px;
    border-radius:    8px;
    background-color: @surface0;
    children:         [ textbox-prompt-colon, entry, num-filtered-rows, textbox-num-sep, num-rows ];
}

textbox-prompt-colon {
    str:        "󰍉";
    expand:     false;
    font:       "FiraCode Nerd Font 15";
    text-color: @accent;
}

entry {
    cursor:            text;
    placeholder:       "Search...";
    placeholder-color: @overlay0;
}

num-filtered-rows,
textbox-num-sep,
num-rows {
    expand:     false;
    text-color: @overlay0;
}

textbox-num-sep {
    str: "/";
}

/* ================================================================================================================== */
/* Message                                                                                                            */

textbox {
    padding:          10px 14px;
    border-radius:    8px;
    background-color: @surface0;
    text-color:       @subtext0;
}

/* ================================================================================================================== */
/* List                                                                                                               */

listview {
    lines:        8;
    columns:      1;
    spacing:      6px;
    cycle:        true;
    scrollbar:    false;
    fixed-height: true;
}

element {
    padding:       8px 12px;
    spacing:       12px;
    border-radius: 8px;
    cursor:        pointer;
}

element normal.normal,
element alternate.normal {
    background-color: transparent;
    text-color:       @text;
}

element normal.active,
element alternate.active {
    background-color: transparent;
    text-color:       @accent;
}

element normal.urgent,
element alternate.urgent {
    background-color: transparent;
    text-color:       @red;
}

element selected.normal,
element selected.active {
    background-color: @accent;
    text-color:       @crust;
}

element selected.urgent {
    background-color: @red;
    text-color:       @crust;
}

element-icon {
    size:   24px;
    cursor: inherit;
}

element-text {
    vertical-align: 0.5;
    highlight:      bold;
    text-color:     inherit;
    cursor:         inherit;
}

/* ================================================================================================================== */
/* Tabs                                                                                                               */

mode-switcher {
    spacing: 10px;
}

button {
    padding:          10px;
    border-radius:    8px;
    background-color: @surface0;
    text-color:       @subtext0;
    cursor:           pointer;
}

button selected {
    background-color: @accent;
    text-color:       @crust;
}

/* ================================================================================================================== */
/* Errors                                                                                                             */

error-message {
    padding:          20px;
    border:           2px solid;
    border-color:     @red;
    border-radius:    12px;
    background-color: @base;
}

/* ================================================================================================================== */
