/* ================================================================================================================== */
/* Rofi - Panel: SSH                                                                                                  */
/*                                                                                                                    */
/* Hosts from ~/.ssh/config and known_hosts.                                                                          */
/* ================================================================================================================== */
/* Base Theme                                                                                                         */

@import "../config.d/00-theme.rasi"

/* ================================================================================================================== */
/* Layout                                                                                                             */

window {
    width: 480px;
}

listview {
    lines: 6;
}

element {
    children: [ element-text ];
}

