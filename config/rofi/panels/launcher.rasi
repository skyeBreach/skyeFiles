/* ================================================================================================================== */
/* Rofi - Panel: Launcher                                                                                             */
/*                                                                                                                    */
/* Tabbed search across apps, commands, files, windows and SSH hosts.                                                 */
/* ================================================================================================================== */
/* Base Theme                                                                                                         */

@import "../config.d/00-theme.rasi"

/* ================================================================================================================== */
/* Layout                                                                                                             */

window {
    width: 760px;
}

mainbox {
    children: [ inputbar, mode-switcher, listview ];
}

listview {
    lines: 9;
}

