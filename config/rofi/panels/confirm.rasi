/* ================================================================================================================== */
/* Rofi - Panel: Confirm                                                                                              */
/*                                                                                                                    */
/* Yes / no check before a power action.                                                                              */
/* ================================================================================================================== */
/* Base Theme                                                                                                         */

@import "../config.d/00-theme.rasi"

/* ================================================================================================================== */
/* Layout                                                                                                             */

window {
    width: 360px;
}

mainbox {
    children: [ message, listview ];
}

textbox {
    horizontal-align: 0.5;
}

listview {
    lines:   1;
    columns: 2;
    spacing: 10px;
}

element {
    padding: 16px 0px;
}

element-text {
    font:             "FiraCode Nerd Font 20";
    horizontal-align: 0.5;
}

/* ================================================================================================================== */
