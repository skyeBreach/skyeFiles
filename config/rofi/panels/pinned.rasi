/* ================================================================================================================== */
/* Rofi - Panel: Pinned                                                                                               */
/*                                                                                                                    */
/* Big-icon grid of pinned apps. scripts/pinned sets the columns and rows to fit the list.                            */
/* ================================================================================================================== */
/* Base Theme                                                                                                         */

@import "../config.d/00-theme.rasi"

/* ================================================================================================================== */
/* Layout                                                                                                             */

window {
    width: 640px;
}

mainbox {
    children: [ inputbar, listview, message ];
}

inputbar {
    children: [ textbox-prompt-colon, entry ];
}

textbox-prompt-colon {
    str: "󰀻";
}

listview {
    flow:          horizontal;
    spacing:       10px;
    fixed-columns: true;
}

element {
    orientation: vertical;
    padding:     16px 8px;
    spacing:     10px;
}

element-icon {
    size: 56px;
}

element-text {
    horizontal-align: 0.5;
}

textbox {
    horizontal-align: 0.5;
}

/* ================================================================================================================== */
