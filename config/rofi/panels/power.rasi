/* ================================================================================================================== */
/* Rofi - Panel: Power                                                                                                */
/*                                                                                                                    */
/* One row of buttons, no search bar.                                                                                 */
/* ================================================================================================================== */
/* Base Theme                                                                                                         */

@import "../config.d/00-theme.rasi"

/* ================================================================================================================== */
/* Layout                                                                                                             */

window {
    width: 720px;
}

mainbox {
    children: [ listview ];
}

listview {
    lines: 1;
    columns: 5;
    spacing: 8px;
    scrollbar: false;
}

element {
    padding: 16px 0px;
    children: [ element-text ];
}

element-text {
    horizontal-align: 0.5;
}

/* ================================================================================================================== */
