/* ================================================================================================================== */
/* Rofi - Panel: Power                                                                                                */
/*                                                                                                                    */
/* A row of square icon buttons under the host and uptime.                                                            */
/* ================================================================================================================== */
/* Base Theme                                                                                                         */

@import "../config.d/00-theme.rasi"

/* ================================================================================================================== */
/* Layout                                                                                                             */

window {
    width: 600px;
}

mainbox {
    children: [ inputbar, listview ];
}

inputbar {
    padding:          0px;
    background-color: transparent;
    children:         [ textbox-prompt-colon, prompt ];
}

textbox-prompt-colon {
    str:              "󰐥";
    padding:          10px 14px;
    border-radius:    8px;
    background-color: @red;
    text-color:       @crust;
}

prompt {
    padding:          10px 14px;
    border-radius:    8px;
    background-color: @surface0;
    text-color:       @subtext0;
}

listview {
    lines:   1;
    columns: 5;
    spacing: 10px;
}

element {
    padding: 22px 0px;
}

element-text {
    font:             "FiraCode Nerd Font 24";
    horizontal-align: 0.5;
}

/* ================================================================================================================== */
