/* ================================================================================================================== */
/* Rofi - Panel: Apps                                                                                                 */
/*                                                                                                                    */
/* Pinned apps first, then every installed app.                                                                       */
/* ================================================================================================================== */
/* Base Theme                                                                                                         */

@import "../config.d/00-theme.rasi"

/* ================================================================================================================== */
/* Layout                                                                                                             */

window {
    width: 760px;
}

/* columns is set by scripts/panel, so the pinned row and the grid always agree */
listview {
    lines: 4;
    flow: horizontal;
    spacing: 8px;
    fixed-columns: true;
}

element {
    orientation: vertical;
    padding: 10px 4px;
    spacing: 6px;
}

element-icon {
    size: 48px;
}

element-text {
    horizontal-align: 0.5;
}

/* ================================================================================================================== */
/* Pinned Row                                                                                                         */

element normal.active,
element alternate.active {
    background-color: @surface0;
    text-color:       @text;
}

element selected.active {
    background-color: @mauve;
    text-color:       @base;
}

/* ================================================================================================================== */
