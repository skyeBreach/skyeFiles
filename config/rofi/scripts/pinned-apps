#!/usr/bin/env zsh
# ==================================================================================================================== #
# Rofi - Pinned Apps
#
# Rofi script mode used inside the apps panel's combi, ahead of drun. With no selection it lists the apps from
# pinned.conf as the grid's top row (styled as "active"), padded with blank cells so the full app list starts on a
# fresh row. When rofi calls it back with a selection, it launches it.
#
# See:
#   - https://github.com/davatorium/rofi/blob/next/doc/rofi-script.5.markdown
# ==================================================================================================================== #
# Configuration

pinned_file="${XDG_CONFIG_HOME:-$HOME/.config}/rofi/pinned.conf"
columns="${PINNED_COLUMNS:-6}"
data_dirs=("${XDG_DATA_HOME:-$HOME/.local/share}" ${(s.:.)${XDG_DATA_DIRS:-/usr/local/share:/usr/share}})

# ==================================================================================================================== #
# Helpers

# Print the path of a desktop file ID, searching the XDG data dirs in priority order.
desktop_path() {
    local dir
    for dir in "${data_dirs[@]}"; do
        if [[ -r "$dir/applications/$1" ]]; then
            print -r -- "$dir/applications/$1"
            return 0
        fi
    done
    return 1
}

# Print one key's value from a desktop file's [Desktop Entry] section.
desktop_value() {
    awk -F= -v key="$2" '
        /^\[/ { section = $0 }
        section == "[Desktop Entry]" && $1 == key { print substr($0, index($0, "=") + 1); exit }
    ' "$1"
}

# Print a blank cell that cannot be selected. rofi drops empty rows, so the cell holds a zero-width space: it shows
# nothing, and you never type it, so it vanishes as soon as you start filtering.
blank_cell() {
    print -rn -- $'\u200b'$'\0'"nonselectable"$'\x1f'"true"$'\n'
}

# ==================================================================================================================== #
# Launch

# ROFI_RETV=1 means rofi is calling back with the chosen row. ROFI_INFO holds its desktop file path.
if [[ "${ROFI_RETV:-0}" == 1 && -n "${ROFI_INFO:-}" ]]; then
    setsid -f dex "$ROFI_INFO" > /dev/null 2>&1
    exit 0
fi

# ==================================================================================================================== #
# List

[[ -r "$pinned_file" ]] || exit 0

count=0

for id in ${(f)"$(grep -vE '^[[:space:]]*(#|$)' "$pinned_file")"}; do
    desktop_file="$(desktop_path "$id")" || continue
    name="$(desktop_value "$desktop_file" Name)"
    icon="$(desktop_value "$desktop_file" Icon)"

    print -rn -- "$name"$'\0'"icon"$'\x1f'"$icon"$'\x1f'"info"$'\x1f'"$desktop_file"$'\x1f'"active"$'\x1f'"true"$'\n'
    (( count += 1 ))
done

# Pad the last pinned row so the full app list starts on a row of its own.
if (( count % columns != 0 )); then
    repeat $(( columns - count % columns )) blank_cell
fi

# ==================================================================================================================== #
