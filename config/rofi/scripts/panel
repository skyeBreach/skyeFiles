#!/usr/bin/env zsh
# ==================================================================================================================== #
# Rofi - Panel Launcher
#
# Opens one rofi panel by name.
# Usage: panel launcher [apps|run|files|windows|ssh] [filter]
#        panel pinned
#        panel power
# ==================================================================================================================== #
# Configuration

set -euo pipefail

rofi_dir="${XDG_CONFIG_HOME:-$HOME/.config}/rofi"
panel="${1:-pinned}"

# Friendly tab names -> rofi mode names
typeset -A tabs=(
    apps    drun
    run     run
    files   filebrowser
    windows window
    ssh     ssh
)

# ==================================================================================================================== #
# Panels

case "$panel" in
    launcher)
        tab="${tabs[${2:-apps}]:-drun}"
        args=(-show "$tab" -theme "$rofi_dir/panels/launcher.rasi")
        if [[ -n "${3:-}" ]]; then
            args+=(-filter "$3")
        fi
        exec rofi "${args[@]}"
        ;;
    pinned)
        exec "$rofi_dir/scripts/pinned"
        ;;
    power)
        exec "$rofi_dir/scripts/power-menu"
        ;;
    *)
        print -u2 "panel: unknown panel '$panel' (launcher, pinned, power)"
        exit 1
        ;;
esac

# ==================================================================================================================== #
