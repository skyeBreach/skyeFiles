#!/usr/bin/env zsh
# ==================================================================================================================== #
# Rofi - Power Menu
#
# Rofi script mode: run with no argument to list the options, rofi runs it again with the chosen option.
#
# See:
#   - https://github.com/davatorium/rofi/blob/next/doc/rofi-script.5.markdown
# ==================================================================================================================== #
# Options

typeset -A actions=(
    "󰌾  Lock"      "betterlockscreen -l dim"
    "󰍃  Logout"    "i3-msg exit"
    "󰤄  Suspend"   "systemctl suspend"
    "󰜉  Reboot"    "systemctl reboot"
    "󰐥  Shutdown"  "systemctl poweroff"
)
order=("󰌾  Lock" "󰍃  Logout" "󰤄  Suspend" "󰜉  Reboot" "󰐥  Shutdown")

# ==================================================================================================================== #
# Menu

if [[ -z "$1" ]]; then
    print -l "${order[@]}"
    exit 0
fi

command="${actions[$1]}"
[[ -n "$command" ]] || exit 1

setsid -f zsh -c "$command" > /dev/null 2>&1

# ==================================================================================================================== #
