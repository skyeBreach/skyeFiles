#!/usr/bin/env zsh
# ==================================================================================================================== #
# Rofi - Power Menu
#
# A row of icon buttons under the host and uptime. Logout, reboot and shutdown ask for a yes / no first.
# ==================================================================================================================== #
# Configuration

rofi_dir="${XDG_CONFIG_HOME:-$HOME/.config}/rofi"

lock="󰌾"
suspend="󰤄"
logout="󰍃"
reboot="󰜉"
shutdown="󰐥"
yes="󰄬"
no="󰅖"

uptime_text="$(uptime -p | sed 's/^up //')"

# ==================================================================================================================== #
# Helpers

# Ask a yes / no question. Succeeds only on yes.
confirm() {
    local answer
    answer="$(print -l "$yes" "$no" | rofi -dmenu -mesg "$1" -theme "$rofi_dir/panels/confirm.rasi")"
    [[ "$answer" == "$yes" ]]
}

# Run a command detached from rofi, so rofi can close first.
run_detached() {
    setsid -f "$@" > /dev/null 2>&1
}

# ==================================================================================================================== #
# Menu

choice="$(
    print -l "$lock" "$suspend" "$logout" "$reboot" "$shutdown" \
        | rofi -dmenu -p "$HOST  ·  up $uptime_text" -theme "$rofi_dir/panels/power.rasi"
)" || exit 0

case "$choice" in
    "$lock")     run_detached betterlockscreen -l dim ;;
    "$suspend")  run_detached systemctl suspend ;;
    "$logout")   confirm "Log out?" && run_detached i3-msg exit ;;
    "$reboot")   confirm "Reboot?" && run_detached systemctl reboot ;;
    "$shutdown") confirm "Shut down?" && run_detached systemctl poweroff ;;
esac

# ==================================================================================================================== #
