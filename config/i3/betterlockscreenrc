# ~/.config/betterlockscreenrc

# default options
display_on=0
span_image=false
lock_timeout=300
fx_list=(dim blur dimblur pixel dimpixel color)
dim_level=40
blur_level=1
pixel_scale=10,1000
solid_color=333333
wallpaper_cmd="feh --bg-fill ~/.config/betterlockscreen/wallpapers/arch_logo-pastel_purple.png"
quiet=false

# default theme
loginbox=24273aee
loginshadow=00000000
locktext="Type password to unlock..."
font="FiraCode Nerd Font"
ringcolor=b7bdf8ff
insidecolor=00000000
separatorcolor=00000000
ringvercolor=8aadf4ff
insidevercolor=00000000
ringwrongcolor=ed8796ff
insidewrongcolor=00000000
timecolor=cad3f5ff
time_format="%H:%M:%S"
greetercolor=cad3f5ff
layoutcolor=cad3f5ff
keyhlcolor=c6a0f6ff
bshlcolor=f5a97fff
veriftext="Verifying..."
verifcolor=8aadf4ff
wrongtext="Failure!"
wrongcolor=ed8796ff
modifcolor=ed8796ff
bgcolor=24273aff


#
# expert options (change at own risk!)
#

# i3lockcolor_bin="i3lock-color"      # Manually set command for i3lock-color
# suspend_command="systemctl suspend" # Manually change action e.g. hibernate/suspend-command

# i3lock-color - custom arguments
# lockargs=() 						  # overwriting default "(-n)"
lockargs+=(--ignore-empty-password) # appending new argument
