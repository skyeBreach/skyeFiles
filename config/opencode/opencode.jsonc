{
    "$schema": "https://opencode.ai/config.json",
    "lsp": true,
    "provider": {
        "ollama": {
            "name": "Ollama",
            "npm": "@ai-sdk/openai-compatible"
        }
    },
    "plugin": ["@dietrichgebert/ponytail"],
    "mcp": {
        "penpot": {
            "type": "remote",
            "enabled": true,
            "url": "http://localhost:9001/mcp/stream?userToken={{ secret(name="opencode_penpot_token") }}"
        },
        "hubspot": {
            "type": "remote",
            "enabled": true,
            "url": "https://mcp.hubspot.com",
            "oauth": {
                "clientId": "{{ secret(name="opencode_hubspot_client_id") }}",
                "clientSecret": "{{ secret(name="opencode_hubspot_client_secret") }}"
            }
        },
        "plane": {
            "type": "local",
            "enabled": true,
            "command": ["uvx", "plane-mcp-server", "stdio"],
            "environment": {
                "PLANE_API_KEY": "{env:OPENCODE_PLANE_ACCESS_TOKEN}",
                "PLANE_WORKSPACE_SLUG": "{env:OPENCODE_PLANE_WORKSPACE_SLUG}"
            }
        },
        "discord": {
            "type": "local",
            "command": ["bun", "/home/skye/.config/opencode/plugins/discord-mcp/index.mjs"],
            "environment": {
                "DISCORD_USER_TOKEN": "{{ secret(name="opencode_discord_token") }}"
            }
        },
        "slack": {
            "type": "local",
            "command": ["bun", "run", "/home/skye/.config/opencode/plugins/slack-mcp/index.ts"],
            "environment": {
                "SLACK_BOT_TOKEN": "{{ secret(name="opencode_slack_token") }}"
            }
        }
    }
}
