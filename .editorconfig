# ==================================================================================================================== #
# EditorConfig - User Root
#
# See:
#   - https://EditorConfig.org
# ==================================================================================================================== #
# Global

root = true

[*]
end_of_line = lf
insert_final_newline = true
charset = utf-8
indent_style = space
indent_size = 4
rulers = 120

[{Makefile,justfile}]
indent_style = tab
