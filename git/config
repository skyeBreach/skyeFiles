[user]
	name = skyeBreach
	email = skyebenson@hotmail.com
    useConfigOnly = true

[core]
    editor = nvim
    pager = delta

[init]
    defaultBranch = main

[push]
    autoSetupRemote = true

[merge]
    conflictStyle = zdiff3

[interactive]
    diffFilter = delta --color-only

[alias]
    clone = clone --depth=1
    rclone = clone --recursive

[safe]
    directory = *

[color]
    diff = auto
    status = auto
    branch = auto

[delta]
    navigate = true  # use n and N to move between diff sections
    dark = true      # or light = true, or omit for auto-detection
    line-numbers = true

